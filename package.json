{
  "name": "kglvs-report-ocr-engine",
  "version": "1.0.0",
  "description": "Executive Report OCR & Extraction Engine for KGLVS (Khong Gian Lam Viec So)",
  "main": "dist/server.js",
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "evaluate": "tsx scripts/evaluate-reports.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "mammoth": "^1.12.1",
    "pdfkit": "^0.19.1",
    "pdfmake": "^0.3.11",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/pdfkit": "^0.17.6",
    "@types/pdfmake": "^0.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
